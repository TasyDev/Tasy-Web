---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { PageHero } from '../../components/organisms/sections/PageHero';
import { BlogList } from '../../components/organisms/grids/BlogList';

// Fetch actual data from content collections
const allPosts = await getCollection('blog');

// Map to the format expected by BlogList
const blogPosts = allPosts.map(post => {
  const slug = post.id.replace(/\.(md|mdx)$/, '');
  return {
    id: post.id,
    image: post.data.image || 'https://placehold.co/396x223',
    category: post.data.category || 'GENERAL',
    date: post.data.date || 'Jan 1, 2024',
    title: post.data.title,
    description: post.data.description,
    href: `/blog/${slug}`
  };
});

// Extract unique categories and add 'All Posts'
const uniqueCategories = [...new Set(blogPosts.map(p => p.category))];
const categories = ["All Posts", ...uniqueCategories];
---

<Layout title="Blog | Tasy Web">
  <main class="w-full bg-white flex flex-col justify-start items-center pb-32">
    <PageHero 
      badge="OUR BLOG"
      titleNormal="Insights &"
      titleHighlight="Ideas"
      description="Thoughts, strategies, and industry trends on premium digital product design, branding, and modern architecture."
    />
    
    <div class="w-full max-w-[1200px] px-8 pt-12 flex flex-col justify-start items-center">
      <BlogList client:load items={blogPosts} categories={categories} />
    </div>
  </main>
</Layout>
