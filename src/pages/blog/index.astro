---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Heading } from '../../components/atoms/text/Heading';
import { CTASection } from '../../components/organisms/sections/CTASection';

const posts = await getCollection('blog');
---

<Layout title="Blog | Design Agency">
  <main class="bg-white min-h-screen">
    <header class="w-full px-8 pt-32 pb-16 flex flex-col items-center text-center">
      <Heading level={1} variant="display">Insights & Thinking</Heading>
      <p class="mt-6 text-neutral-400 text-xl max-w-2xl font-sans">
        Ideas, processes, and perspectives from our design team.
      </p>
    </header>

    <section class="max-w-[800px] mx-auto px-8 pb-32">
      {posts.map((post) => (
        <a 
          href={`/blog/${post.id.replace(/\.(md|mdx)$/, '')}`} 
          class="group block py-12 border-b border-gray-100 last:border-0 hover:opacity-80 transition-opacity"
        >
          <span class="text-amber-700 text-sm font-bold font-sans uppercase tracking-widest">{post.data.date}</span>
          <Heading level={2} variant="section" className="mt-4 group-hover:text-amber-700 transition-colors">{post.data.title}</Heading>
          <p class="mt-4 text-neutral-500 text-lg font-sans leading-relaxed">{post.data.description}</p>
          <span class="mt-6 inline-block text-amber-700 text-sm font-semibold font-sans uppercase tracking-wider">Read more →</span>
        </a>
      ))}
    </section>

    <CTASection client:load />
  </main>
</Layout>
