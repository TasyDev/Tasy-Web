---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Heading } from '../../components/atoms/text/Heading';
import { ProjectCard } from '../../components/molecules/cards/ProjectCard';
import { CTASection } from '../../components/organisms/sections/CTASection';

const projects = await getCollection('portfolio');
---

<Layout title="Portfolio | Design Agency">
  <main class="bg-white min-h-screen">
    <header class="w-full px-8 pt-32 pb-16 flex flex-col items-center text-center">
      <Heading level={1} variant="display">Our Portfolio</Heading>
      <p class="mt-6 text-neutral-400 text-xl max-w-2xl font-sans">
        A curated selection of projects where strategy meets premium craftsmanship.
      </p>
    </header>

    <section class="max-w-[1200px] mx-auto px-8 pb-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {projects.map((project) => (
          <ProjectCard 
            title={project.data.title}
            description={project.data.description}
            imageSrc={project.data.image}
            href={`/portfolio/${project.id.replace(/\.(md|mdx)$/, '')}`}
          />
        ))}
      </div>
    </section>

    <CTASection client:load />
  </main>
</Layout>
